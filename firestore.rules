
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Collections ---

    // This rule allows ANYONE to read the collection of professional profiles and all documents within it.
    // The {document=**} wildcard is crucial for allowing both 'list' on the collection
    // and 'get' on the individual documents returned by a query.
    match /professionalProfiles/{document=**} {
      allow read: if true;
    }

    // These rules apply to INDIVIDUAL professional profile documents for WRITE operations.
    match /professionalProfiles/{profileId} {
      // Allow create, update, delete only if the user is signed in and is the owner.
      allow write: if isSignedIn() && request.auth.uid == resource.data.userId;

       match /quotes/{quoteId} {
          allow read, write: if isSignedIn() && isOwner(professionalProfileId); 
      }

      match /reviews/{reviewId} {
        allow read: if true; 
        allow create: if isSignedIn();
        allow update, delete: if false; 
      }
    }

    // Users can only access their own data.
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
  }
}
