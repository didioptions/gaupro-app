rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (getUserData().role == 'admin' || getUserData().role == 'super_admin');
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    // --- Admin Only Collections (Immutable) ---
    match /admin_logs/{logId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }
    
    match /transactions/{txId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    match /review_actions/{actionId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    match /marketplace_audit_logs/{logId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    match /fraud_alerts/{alertId} {
      allow get, list, create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }
    
    match /verifications/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    match /review_disputes/{disputeId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.proUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role);
      
      // Legacy path removed.
    }

    // --- Service Requests (Top-Level) ---
    match /serviceRequests/{requestId} {
      // Allow ANYONE (including guests) to post a job
      allow create: if true;
      // Restricted reading to Admins or the owner (if logged in)
      allow read, get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Public Access Rules ---
    match /professionalProfiles {
      allow list: if true;
      
      match /{profileId} {
        allow get: if true;
        
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId
                      && request.resource.data.get('isProVerified', false) == false
                      && request.resource.data.get('rating', 0) == 0;
        
        allow update: if isAdmin() || (
          isSignedIn() && request.auth.uid == resource.data.userId 
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isProVerified', 
            'verificationStatus', 
            'verifiedAt', 
            'verifiedBy', 
            'rating', 
            'reviewCount', 
            'totalReviews', 
            'featuredStatus', 
            'moderationFlags',
            'priorityRank',
            'userId',
            'email',
            'createdAt'
          ])
        );

        allow delete: if isAdmin();

        match /reviews/{reviewId} {
          allow read: if true;
          // Allow anyone to create a review, but it must be pending
          allow create: if request.resource.data.status == 'pending';
          allow update, delete: if isAdmin();
        }
      }
    }

    // --- Collection Group Access ---
    match /{path=**}/reviews/{reviewId} {
      allow list: if isAdmin();
    }
  }
}