/**
 * @fileoverview Firestore Security Rules for Gaupro.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data
 * while allowing public read access to professional profiles. Write access
 * is restricted to authenticated users with appropriate ownership or
 * association with the resources being modified.
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Collections ---

    // Users can only read and manage their own user document.
    match /users/{userId} {
      allow read, update, delete: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
    }

    // --- Professional Profiles ---
    // Anyone can list the collection of profiles.
    match /professionalProfiles {
      allow list: if true;
    }

    // Rules for individual professional profile documents and their subcollections.
    match /professionalProfiles/{professionalProfileId} {
      // Anyone can read a single professional's profile.
      allow get: if true;

      // Only the authenticated owner of the profile can write to it.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Mirror reads for quotes on the professional's profile.
      match /quotes/{quoteId} {
          allow read: if isSignedIn() && isOwner(professionalProfileId);
          allow create: if canCreateQuote(getAfterData(/databases/$(database)/documents/users/{userId}/serviceRequests/$(request.resource.data.serviceRequestId)).data.userId, request.resource.data.serviceRequestId, quoteId);
          allow update, delete: if false;
      }

      // Mirror reads for reviews on the professional's profile.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if canCreateReview(getAfterData(/databases/$(database)/documents/users/{userId}/serviceRequests/$(request.resource.data.serviceRequestId)).data.userId, request.resource.data.serviceRequestId, reviewId);
        allow update, delete: if false; // Disallow public updates/deletes
      }
    }

    // --- Subcollections ---

    // Users can manage their own service requests.
    match /users/{userId}/serviceRequests/{serviceRequestId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Quotes can be read by the user who owns the service request or the pro who submitted it.
    match /users/{userId}/serviceRequests/{serviceRequestId}/quotes/{quoteId} {
      allow read: if isSignedIn() && (isOwner(userId) || isQuoteOwner(quoteId));
      allow create: if canCreateQuote(userId, serviceRequestId, quoteId);
      allow update, delete: if false; // Quotes are immutable
    }

    // Reviews are publicly readable. A user can create/update a review for their own service request.
    match /users/{userId}/serviceRequests/{serviceRequestId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if canCreateReview(userId, serviceRequestId, reviewId);
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isProfessional() {
      // In a real app, this would check a custom claim or a role.
      return isSignedIn();
    }

    function isQuoteOwner(quoteId) {
        return exists(/databases/$(database)/documents/professionalProfiles/$(request.auth.uid)/quotes/$(quoteId));
    }

    // Function to check if a user can create a quote.
    // This transactionally checks both write locations.
    function canCreateQuote(userId, serviceRequestId, quoteId) {
      let isPro = isProfessional();
      let isProProfileOwner = request.resource.data.professionalProfileId == request.auth.uid;
      let serviceRequestPath = /databases/$(database)/documents/users/$(userId)/serviceRequests/$(serviceRequestId);
      let serviceRequestExists = exists(serviceRequestPath);
      let quoteData = request.resource.data;

      // Ensure the other write in the transaction is to the professional's own quote collection
      let otherWritePath = /databases/$(database)/documents/professionalProfiles/$(quoteData.professionalProfileId)/quotes/$(quoteId);
      let otherWriteData = get(/databases/$(database)/documents/$(otherWritePath)).data;

      return isPro &&
             isProProfileOwner &&
             serviceRequestExists &&
             // Ensure the mirrored write is valid
             request.path != otherWritePath &&
             otherWriteData.amount == quoteData.amount &&
             otherWriteData.serviceRequestId == serviceRequestId;
    }

    // Function to check if a user can create a review.
    function canCreateReview(userId, serviceRequestId, reviewId) {
      let isRequestOwner = isOwner(userId);
      let reviewData = request.resource.data;

      // Ensure the other write is to the professional's review collection
      let otherWritePath = /databases/$(database)/documents/professionalProfiles/$(reviewData.professionalProfileId)/reviews/$(reviewId);
       let otherWriteData = get(/databases/$(database)/documents/$(otherWritePath)).data;

      return isRequestOwner &&
             reviewData.userId == userId &&
             reviewData.serviceRequestId == serviceRequestId &&
             // Ensure the mirrored write is valid
             request.path != otherWritePath &&
             otherWriteData.rating == reviewData.rating &&
             otherWriteData.comment == reviewData.comment;
    }
  }
}
