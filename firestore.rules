
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    
    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {};
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && (data.get('role', 'admin') == 'admin' || data.get('role', 'admin') == 'super_admin');
    }

    // --- Marketplace: Public Leads (SEO & Previews) ---
    match /leads_public/{leadId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.status == 'pending_review' || isAdmin();
      // Only verified professionals or admins can purchase leads
      allow update: if isAdmin() || (isSignedIn() && isEmailVerified() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quoteCount', 'purchasers']));
      allow delete: if isAdmin();
    }

    // --- Marketplace: Private Contact Details ---
    match /leads_private/{leadId} {
      allow read: if isAdmin() || (
        isSignedIn() && 
        isEmailVerified() &&
        exists(/databases/$(database)/documents/leads_public/$(leadId)) &&
        request.auth.uid in get(/databases/$(database)/documents/leads_public/$(leadId)).data.get('purchasers', [])
      );
      allow create: if true; 
      allow update, delete: if isAdmin();
    }

    // --- User Documents ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );

      match /notifications/{notificationId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
      }
    }

    // --- Professional Profiles ---
    match /professionalProfiles/{profileId} {
      allow read: if true;
      allow create: if isSignedIn();
      
      // Updates require verified email for professionals
      allow update: if isAdmin() || (
        isSignedIn() && isEmailVerified() && request.auth.uid == resource.data.userId
        && request.resource.data.get('creditBalance', 0) <= resource.data.get('creditBalance', 0)
        && request.resource.data.get('leadCount', 0) >= resource.data.get('leadCount', 0)
      );

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // --- Audit Logs ---
    match /marketplace_audit_logs/{id} {
        allow read: if isAdmin();
        allow create: if isSignedIn() && isEmailVerified();
        allow update, delete: if isAdmin();
    }
    
    match /admin_logs/{id} {
        allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
