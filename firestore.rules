rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      // CEL-safe check to prevent crashing on unauthenticated requests
      let uid = request.auth != null ? request.auth.uid : null;
      return uid != null && exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data 
        : {};
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && (data.get('role', 'user') == 'admin' || data.get('role', 'user') == 'super_admin');
    }

    // --- Service Requests ---
    match /serviceRequests/{requestId} {
      // Explicitly allow anyone (Guests and Registered Users) to create a lead with pending status
      allow create: if request.resource.data.status == 'pending_review';
      
      // Get: Admins see all; Users see their own; Pros see approved leads
      allow get: if isAdmin() || 
                 (isSignedIn() && resource.data.userId == request.auth.uid) ||
                 (resource.data.status == 'approved');
                 
      // List: Admins see all; Pros can browse the approved lead pool
      allow list: if isAdmin() || (isSignedIn() && getUserData().get('role', 'user') == 'pro');

      // Update/Delete: Restricted to Admins for moderation
      allow update, delete: if isAdmin();
    }

    // --- Professional Profiles ---
    match /professionalProfiles/{profileId} {
      allow read: if true;
      
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == request.resource.data.userId
        && request.resource.data.get('isProVerified', false) == false
      );
      
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == resource.data.userId 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isProVerified', 'rating', 'reviewCount', 'priorityRank'
        ])
      );

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // --- User Documents ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId 
        && request.resource.data.role == resource.data.role
      );
    }

    // --- Marketplace Admin Collections ---
    match /marketplace_audit_logs/{logId} {
      allow get, list, create: if isAdmin();
    }

    match /transactions/{id} {
        allow read: if isAdmin() || (isSignedIn() && resource.data.proUid == request.auth.uid);
        allow create: if isAdmin();
    }
    
    match /admin_logs/{id} {
        allow read, create: if isAdmin();
    }

    // Final Catch-all (Recursive)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}