
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // This rule allows ANYONE to read any document in the database.
    // This will fix the "list" permission error.
    match /{document=**} {
      allow read: if true;
    }

    // --- Write Rules ---

    // Secure writes to the professionalProfiles collection.
    match /professionalProfiles/{profileId} {
      allow write: if isSignedIn() && isOwner(resource.data.userId);

      // Secure the reviews subcollection.
      match /reviews/{reviewId} {
        // Anyone signed in can create a review.
        allow create: if isSignedIn();
        // No one can update or delete reviews directly.
        allow update, delete: if false;
      }
    }

    // Secure writes to the users collection.
    match /users/{userId}/{document=**} {
      // Only the owner of the user document can write to it.
      allow write: if isSignedIn() && isOwner(userId);
    }
  }
}
