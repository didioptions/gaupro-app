rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow anyone to LIST the collection of professionals.
    // This is required for the main category pages to query all profiles.
    match /professionalProfiles {
      allow list: if true;
    }

    // These rules apply to individual documents within the collection.
    match /professionalProfiles/{profileId} {
      // Allow anyone to GET a single professional's profile.
      allow get: if true;
      
      // Allow only the owner of a profile to write to it.
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;

      // Allow anyone to read reviews for a professional.
      match /reviews/{reviewId} {
        allow get, list: if true;
        // Allow any authenticated user to create a review.
        allow create: if request.auth != null;
      }
    }

    // Secure user-specific data. Only the authenticated user can access their own documents.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
