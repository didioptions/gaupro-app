rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      // Hardened to prevent runtime errors for Guest users
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {};
    }

    function isAdmin() {
      // Safely check role after ensuring auth exists
      return isSignedIn() && (getUserData().get('role', 'user') == 'admin' || getUserData().get('role', 'user') == 'super_admin');
    }

    // --- Service Requests ---
    match /serviceRequests/{requestId} {
      // Allow anyone (Guests or Authenticated Users) to create a request
      // We enforce the 'pending_review' status for quality control
      allow create: if request.resource.data.status == 'pending_review';
      
      // Allow users to see their own requests, and Pros to see approved leads
      // Admins can see everything
      allow get: if isAdmin() || 
                 (isSignedIn() && resource.data.userId == request.auth.uid) ||
                 (resource.data.status == 'approved');
                 
      allow list: if isAdmin() || (isSignedIn() && getUserData().get('role', 'user') == 'pro');

      // Only admins can approve/reject/delete leads
      allow update, delete: if isAdmin();
    }

    // --- Professional Profiles ---
    match /professionalProfiles/{profileId} {
      allow read: if true; // Publicly viewable
      
      // Only the owner or an admin can create/update their profile
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == request.resource.data.userId
        && request.resource.data.get('isProVerified', false) == false
        && request.resource.data.get('rating', 0) == 0
      );
      
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == resource.data.userId 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isProVerified', 'rating', 'reviewCount', 'priorityRank'
        ])
      );

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.status == 'pending';
        allow update, delete: if isAdmin();
      }
    }

    // --- User Documents ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Critical: Users cannot change their own 'role' field
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId 
        && request.resource.data.role == resource.data.role
      );
    }

    // --- Admin-Only Collections ---
    match /marketplace_audit_logs/{logId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    // --- Transactions & Logs ---
    match /transactions/{id} {
        allow read: if isAdmin() || (isSignedIn() && resource.data.proUid == request.auth.uid);
        allow create: if isAdmin();
    }
    
    match /admin_logs/{id} {
        allow read, create: if isAdmin();
    }
  }
}
