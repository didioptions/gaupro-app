/**
 * @fileoverview Firestore Security Rules for Gaupro.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data
 * while allowing public read access to professional profiles.  Write access
 * is restricted to authenticated users with appropriate ownership or
 * association with the resources being modified.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow list: if false; // Disallow listing all users.
      allow read: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.id == userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }
    
    match /professionals/{professionalId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /professionalProfiles/{professionalProfileId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /users/{userId}/serviceRequests/{serviceRequestId} {
      allow read, create, update: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    match /professionalProfiles/{professionalProfileId}/quotes/{quoteId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId}/serviceRequests/{serviceRequestId}/quotes/{quoteId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/serviceRequests/{serviceRequestId}/reviews/{reviewId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    match /professionalProfiles/{professionalProfileId}/reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}
