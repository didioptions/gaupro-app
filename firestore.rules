rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Public Access Rules for 'companies' ---
    match /companies/{companyId} {
      // This allows public read access for both single documents (get) and queries (list)
      allow read: if true; 
    }

    // --- Public Access Rules for 'professionalProfiles' ---
    match /professionalProfiles {
      // This rule allows ANYONE to query the list of professionals.
      // This is required for the category pages to function.
      allow list: if true;
      
      // These rules apply to INDIVIDUAL documents within the collection
      match /{profileId} {
        // This rule allows ANYONE to read a single professional's profile.
        allow get: if true;
        
        // --- Write Access Rules ---
        // Only the authenticated owner of a profile can write to it.
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;

        // --- Subcollection Rules ---
        match /reviews/{reviewId} {
          allow read: if true;
          // Allow any authenticated user to create or delete their own review.
          allow create: if request.auth != null;
          allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
        }
      }
    }

    // --- User-Specific Data Rules ---
    // Secure all documents within a user's private folder.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
