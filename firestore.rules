
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (getUserData().role == 'admin' || getUserData().role == 'super_admin');
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    // --- Admin Only Collections (Immutable) ---
    match /admin_logs/{logId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }
    
    match /transactions/{txId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    match /review_actions/{actionId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    match /marketplace_audit_logs/{logId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    match /fraud_alerts/{alertId} {
      allow get, list, create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }
    
    match /verifications/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role);
    }

    // --- Public Access Rules ---
    match /professionalProfiles {
      allow list: if true;
      
      match /{profileId} {
        allow get: if true;
        
        // Allow professionals to update their own profiles
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
        allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
        allow delete: if isAdmin();

        match /reviews/{reviewId} {
          allow read: if true;
          allow create: if isSignedIn();
          allow update: if isAdmin();
          allow delete: if isAdmin();
        }
      }
    }

    // --- Job Requests (The fix for your error) ---
    match /users/{userId}/serviceRequests/{requestId} {
      // Allow ANYONE (even guests) to create a job request
      allow create: if true;
      // Only the owner or Admin can read/delete them
      allow read, update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // --- Catch-all for other user data ---
    match /users/{userId}/{document=**} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // --- Collection Group Access (For Admin Oversight) ---
    match /{path=**}/reviews/{reviewId} {
      allow list: if isAdmin();
    }
    
    match /{path=**}/serviceRequests/{requestId} {
      allow list: if isAdmin();
    }
  }
}
