rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow anyone to read single professional profiles
    match /professionalProfiles/{profileId} {
      allow get: if true;
    }

    // Allow anyone to list the collection of professional profiles for searching/browsing
    match /professionalProfiles {
      allow list: if true;
    }

    // --- Write Rules ---

    // Secure writes to the professionalProfiles collection.
    // Only the owner of the profile can write to it.
    match /professionalProfiles/{profileId} {
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Allow any signed-in user to create a review.
    match /professionalProfiles/{profileId}/reviews/{reviewId} {
        allow create: if request.auth != null;
    }

    // Secure the users collection
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
