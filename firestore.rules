
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Collections ---

    // This rule allows ANYONE to query the collection of professional profiles.
    // This is required for the public-facing pages to display lists of pros.
    match /professionalProfiles {
      allow list: if true;
    }

    // These rules apply to INDIVIDUAL professional profile documents.
    match /professionalProfiles/{profileId} {
      // Allow anyone to GET a single document.
      allow get: if true;

      // Allow create, update, delete only if the user is signed in and is the owner.
      allow create, update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;

       match /quotes/{quoteId} {
          allow read, write: if isSignedIn() && isOwner(professionalProfileId); 
      }

      match /reviews/{reviewId} {
        allow read: if true; 
        allow create: if isSignedIn();
        allow update, delete: if false; 
      }
    }

    // Users can only access their own data.
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
  }
}
