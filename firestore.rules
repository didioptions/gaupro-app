
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Collections ---
    
    // This is a broad rule to allow public read access to all data,
    // which is necessary to fix the current "list" permission error.
    // It restricts all writes to authenticated users as a baseline security measure.
    // We will refine this after confirming the fix.
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // The rules below are currently not being used because the broad rule above
    // takes precedence for read operations. They will be re-enabled and
    // correctly configured once the main error is resolved.

    // Allow create, update, delete only if the user is signed in and is the owner.
    match /professionalProfiles/{profileId} {
      allow write: if isSignedIn() && request.auth.uid == resource.data.userId;

      // Sub-collections can have their own rules here.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // Users can only access their own data.
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
  }
}
