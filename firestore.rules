rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Collections ---

    // Rules for the 'professionalProfiles' collection
    match /professionalProfiles/{profileId} {
      // Allow anyone to GET a single professional's profile.
      allow get: if true;

      // Allow a user to WRITE to their own profile if they are signed in.
      allow write: if isSignedIn() && isOwner(resource.data.userId);

      // Allow public read for reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }
    
    // Explicitly allow LISTING the entire professionalProfiles collection for public access.
    // This is required for the service category pages to work.
    match /professionalProfiles {
        allow list: if true;
    }

    // Rules for the 'users' collection
    match /users/{userId}/{document=**} {
      // Users can only access their own data.
      allow read, write: if isSignedIn() && isOwner(userId);
    }
  }
}
