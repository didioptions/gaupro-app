/**
 * @fileoverview Firestore Security Rules for Gaupro.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data
 * while allowing public read access to professional profiles.  Write access
 * is restricted to authenticated users with appropriate ownership or
 * association with the resources being modified.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /professionalProfiles/{professionalProfileId}: Stores professional profiles.
 * - /users/{userId}/serviceRequests/{serviceRequestId}: Stores service requests submitted by users.
 * - /professionalProfiles/{professionalProfileId}/quotes/{quoteId}: Stores quotes provided by professionals.
 * - /users/{userId}/serviceRequests/{serviceRequestId}/quotes/{quoteId}: Stores quotes related to user service requests.
 * - /users/{userId}/serviceRequests/{serviceRequestId}/reviews/{reviewId}: Stores reviews for a service request by the user.
 * - /professionalProfiles/{professionalProfileId}/reviews/{reviewId}: Stores reviews for a professional profile.
 *
 * Key Security Decisions:
 * - Users can only create, update, or delete their own profiles and service requests.
 * - Professional profiles are publicly readable but write access is not defined.
 * - Listing of user documents is allowed only to the owning user.
 *
 * Denormalization for Authorization:
 * - For simplicity and performance, ownership is determined directly via the
 *   document path (e.g., /users/{userId}).  No additional data is denormalized
 *   in this version.
 *
 * Structural Segregation:
 * - User-specific data (service requests) is stored under the /users/{userId}
 *   collection, ensuring a clear separation of concerns and simplified security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     *    - request.auth.uid: 'user123'
     *    - request.resource.data.id: 'user123'
     * @allow (get) User with ID 'user123' can get their profile.
     *    - request.auth.uid: 'user123'
     * @allow (update) User with ID 'user123' can update their profile.
     *    - request.auth.uid: 'user123'
     * @allow (delete) User with ID 'user123' can delete their profile.
     *    - request.auth.uid: 'user123'
     * @deny (create) User with ID 'user456' attempts to create a profile for 'user123'.
     *    - request.auth.uid: 'user456'
     *    - request.resource.data.id: 'user123'
     * @principle Enforces document ownership for writes, validates ID on creation, and requires authentication.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Listing user documents is disallowed.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.id == userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to professional profiles.
     * @path /professionalProfiles/{professionalProfileId}
     * @allow (get) Any user can retrieve a professional profile.
     *    - request.auth.uid: 'user123' (or null if anonymous)
     * @allow (list) Any user can list professional profiles.
     *    - request.auth.uid: 'user123' (or null if anonymous)
     * @deny (create) No one can create a professional profile via the client.
     *    - request.auth.uid: 'user123'
     * @principle Allows public read access, restricts write access.
     */
    match /professionalProfiles/{professionalProfileId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to service requests for a specific user.
     * @path /users/{userId}/serviceRequests/{serviceRequestId}
     * @allow (create) User with ID 'user123' can create a service request.
     *    - request.auth.uid: 'user123'
     *    - request.resource.data.userId: 'user123'
     * @allow (get) User with ID 'user123' can get their service request.
     *    - request.auth.uid: 'user123'
     * @allow (list) User with ID 'user123' can list their service requests.
     *    - request.auth.uid: 'user123'
     * @allow (update) User with ID 'user123' can update their service request.
     *    - request.auth.uid: 'user123'
     * @allow (delete) User with ID 'user123' can delete their service request.
     *    - request.auth.uid: 'user123'
     * @deny (create) User with ID 'user456' attempts to create a service request for 'user123'.
     *    - request.auth.uid: 'user456'
     *    - request.resource.data.userId: 'user123'
     * @principle Enforces document ownership for writes and requires authentication.
     */
    match /users/{userId}/serviceRequests/{serviceRequestId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to quotes for a specific professional profile.
     * @path /professionalProfiles/{professionalProfileId}/quotes/{quoteId}
     * @deny (create) No one can create a quote via the client.
     *    - request.auth.uid: 'user123'
     * @principle Restricts write access.
     */
    match /professionalProfiles/{professionalProfileId}/quotes/{quoteId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to quotes for a specific user's service request.
     * @path /users/{userId}/serviceRequests/{serviceRequestId}/quotes/{quoteId}
     *  @allow (get) User with ID 'user123' can get their quote.
     *    - request.auth.uid: 'user123'
     *  @allow (list) User with ID 'user123' can list their quotes.
     *    - request.auth.uid: 'user123'
     * @deny (create) No one can create a quote via the client.
     *    - request.auth.uid: 'user123'
     * @principle Restricts write access, allows read access to owner.
     */
    match /users/{userId}/serviceRequests/{serviceRequestId}/quotes/{quoteId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to reviews for a specific user's service request.
     * @path /users/{userId}/serviceRequests/{serviceRequestId}/reviews/{reviewId}
     * @allow (create) User with ID 'user123' can create a review for their service request.
     *    - request.auth.uid: 'user123'
     *    - request.resource.data.userId: 'user123'
     * @allow (get) User with ID 'user123' can get their review.
     *    - request.auth.uid: 'user123'
     * @allow (list) User with ID 'user123' can list their reviews.
     *    - request.auth.uid: 'user123'
     * @allow (update) User with ID 'user123' can update their review.
     *    - request.auth.uid: 'user123'
     * @allow (delete) User with ID 'user123' can delete their review.
     *    - request.auth.uid: 'user123'
     * @deny (create) User with ID 'user456' attempts to create a review for 'user123'.
     *    - request.auth.uid: 'user456'
     *    - request.resource.data.userId: 'user123'
     * @principle Enforces document ownership for writes and requires authentication.
     */
    match /users/{userId}/serviceRequests/{serviceRequestId}/reviews/{reviewId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to reviews for a specific professional profile.
     * @path /professionalProfiles/{professionalProfileId}/reviews/{reviewId}
     * @deny (create) No one can create a review via the client.
     *    - request.auth.uid: 'user123'
     * @principle Restricts write access.
     */
    match /professionalProfiles/{professionalProfileId}/reviews/{reviewId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}