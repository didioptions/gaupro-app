rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      // Safely retrieve user data, returning empty map if not signed in or doc missing
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {};
    }

    function isAdmin() {
      // Safely check role after ensuring auth exists
      let data = getUserData();
      return isSignedIn() && (data.get('role', 'user') == 'admin' || data.get('role', 'user') == 'super_admin');
    }

    // --- Marketplace: Public Leads (SEO & Previews) ---
    match /leads_public/{leadId} {
      // Anyone can see approved lead previews for SEO
      allow read: if resource.data.status == 'approved' || isAdmin();
      
      // Anyone (Guest or User) can submit a lead with status 'pending_review'
      allow create: if request.resource.data.status == 'pending_review';
      
      allow update, delete: if isAdmin();
    }

    // --- Marketplace: Private Contact Details ---
    match /leads_private/{leadId} {
      // ONLY logged in users or admins can access contact details
      allow read: if isSignedIn() || isAdmin();
      
      // Allow creation during the dual-write submission process
      allow create: if true; 
      
      allow update, delete: if isAdmin();
    }

    // --- User Documents ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Critical: Users cannot change their own 'role' field
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId 
        && request.resource.data.role == resource.data.role
      );
    }

    // --- Professional Profiles ---
    match /professionalProfiles/{profileId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // --- Audit Logs (Admin Only) ---
    match /marketplace_audit_logs/{id} {
        allow read, write: if isAdmin();
    }
    
    match /admin_logs/{id} {
        allow read, write: if isAdmin();
    }

    // Final Catch-all (Admin Restricted)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}