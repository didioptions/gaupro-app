
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Collections ---

    // This rule allows ANYONE to read the collection and its documents.
    match /professionalProfiles/{document=**} {
      allow read: if true;
    }
    
    // This rule secures writes to only the owner of the profile.
    match /professionalProfiles/{profileId} {
      allow write: if isSignedIn() && isOwner(resource.data.userId);

      // Secure the subcollection as well
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // Rules for the 'users' collection
    match /users/{userId}/{document=**} {
      // Users can only access their own data.
      allow read, write: if isSignedIn() && isOwner(userId);
    }
  }
}
