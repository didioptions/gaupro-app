
/**
 * @fileoverview Firestore Security Rules for Gaupro.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data
 * while allowing public read access to professional profiles. Write access
 * is restricted to authenticated users with appropriate ownership or
 * association with the resources being modified.
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and manage their own user document.
    match /users/{userId} {
      allow read, update, delete: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
    }
    
    // Anyone can read professional profiles, but only the linked user can modify them.
    match /professionalProfiles/{professionalProfileId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Users can manage their own service requests.
    match /users/{userId}/serviceRequests/{serviceRequestId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Professionals can create quotes for requests, and users can read quotes for their requests.
    match /users/{userId}/serviceRequests/{serviceRequestId}/quotes/{quoteId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isProfessional() && request.resource.data.serviceRequestId == serviceRequestId;
      allow update, delete: if false; // Quotes are typically immutable once created.
    }
    
    // Professionals can also see quotes under their own profile.
    match /professionalProfiles/{professionalProfileId}/quotes/{quoteId} {
        allow read: if isSignedIn() && resource.data.professionalProfileId == professionalProfileId;
        // Mirror the creation rule from the user's path.
        allow create: if isSignedIn() && isProfessional() && request.resource.data.professionalProfileId == professionalProfileId;
        allow update, delete: if false;
    }

    // Users can create reviews for services they requested.
    match /users/{userId}/serviceRequests/{serviceRequestId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId; // Allow user to edit their review.
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // Publicly readable reviews for a professional's profile.
    match /professionalProfiles/{professionalProfileId}/reviews/{reviewId} {
      allow read: if true;
      // Mirror the creation rule to allow reviews to be written here as well.
      allow create: if isSignedIn() && request.resource.data.professionalProfileId == professionalProfileId;
      allow update, delete: if false; // Disallow public updates/deletes for integrity.
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Placeholder function to check if a user is a professional.
    // In a real app, this would check a custom claim or a role in the user's document.
    function isProfessional() {
        // Example: return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isProfessional == true;
        return isSignedIn(); // For now, allow any signed-in user to act as a professional.
    }
  }
}
