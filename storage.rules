rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // --- Helper Functions ---
    
    // Check if the user has an admin or super_admin role in Firestore
    function isAdmin() {
      return request.auth != null && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // --- Access Rules ---

    // 1. Professional Profiles (Public Assets)
    // Logos and portfolio photos must be readable by everyone (customers)
    // but only writable by the owner.
    match /profiles/{profileId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == profileId;
    }

    // 2. Verification Documents (Highly Sensitive)
    // Contains ID documents and selfies. Restricted to the owner and admins.
    match /verifications/{userId}/{fileName} {
      // Users can only read their own documents. Admins can read all for review.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Users can only upload (create) their own documents. 
      // We deny 'update' to prevent tampering once a document is submitted.
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Only admins can delete verification files (e.g. for system cleanup).
      allow update, delete: if isAdmin();
    }

    // 3. Admin Uploads & Media Manager
    // General uploads via the admin media manager are restricted to admins.
    match /uploads/{fileName} {
       allow read, write: if isAdmin();
    }
    
    // 4. Fallback (Default Deny)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}