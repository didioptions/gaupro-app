rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (getUserData().role == 'admin' || getUserData().role == 'super_admin');
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    // --- Admin Only Collections (Immutable) ---
    match /admin_logs/{logId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }
    
    match /transactions/{txId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    match /review_actions/{actionId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    match /marketplace_audit_logs/{logId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    match /fraud_alerts/{alertId} {
      allow get, list, create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }
    
    match /verifications/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    match /review_disputes/{disputeId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.proUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role);
    }

    // --- Public Access Rules ---
    match /professionalProfiles {
      allow list: if true;
      
      match /{profileId} {
        allow get: if true;
        
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId
                      && request.resource.data.get('isProVerified', false) == false
                      && request.resource.data.get('rating', 0) == 0
                      && request.resource.data.get('reviews', 0) == 0
                      && request.resource.data.get('creditBalance', 0) == 0
                      && request.resource.data.get('priorityRank', 0) == 0;
        
        allow update: if isAdmin() || (
          isSignedIn() && request.auth.uid == resource.data.userId 
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isProVerified', 
            'verificationStatus', 
            'verifiedAt', 
            'verifiedBy', 
            'rating', 
            'reviews',
            'reviewCount', 
            'totalReviews', 
            'creditBalance', 
            'featuredStatus', 
            'moderationFlags',
            'priorityRank',
            'userId',
            'email',
            'createdAt'
          ])
        );

        allow delete: if isAdmin();

        match /reviews/{reviewId} {
          allow read: if true;
          allow create: if isSignedIn() && request.resource.data.status == 'pending';
          allow update: if isAdmin();
          allow delete: if isAdmin();
        }
      }
    }

    // --- User-Specific Data Rules ---
    match /users/{userId}/serviceRequests/{requestId} {
      // Allow guests and users to post jobs
      allow create: if true;
      // Secure reading/editing
      allow read, update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // --- Collection Group Access ---
    match /{path=**}/reviews/{reviewId} {
      allow list: if isAdmin();
    }
    
    match /{path=**}/serviceRequests/{requestId} {
      allow list: if isAdmin();
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
  }
}