rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (getUserData().role == 'admin' || getUserData().role == 'super_admin');
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    // --- Admin Only Collections ---
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }
    
    match /verifications/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role);
    }

    // --- Public Access Rules ---
    match /professionalProfiles {
      allow list: if true;
      
      match /{profileId} {
        allow get: if true;
        
        // Prevent users from creating a "verified" or "funded" profile via self-registration
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId
                      && request.resource.data.get('isProVerified', false) == false
                      && request.resource.data.get('rating', 0) == 0
                      && request.resource.data.get('reviews', 0) == 0
                      && request.resource.data.get('creditBalance', 0) == 0
                      && request.resource.data.get('priorityRank', 0) == 0;
        
        // Field-level security for updates: Owners can only edit content fields
        allow update: if isAdmin() || (
          isSignedIn() && request.auth.uid == resource.data.userId 
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isProVerified', 
            'verificationStatus', 
            'verifiedAt', 
            'verifiedBy', 
            'rating', 
            'reviews',
            'reviewCount', 
            'totalReviews', 
            'creditBalance', 
            'featuredStatus', 
            'moderationFlags',
            'priorityRank',
            'userId',
            'email',
            'createdAt'
          ])
        );

        allow delete: if isAdmin();

        match /reviews/{reviewId} {
          allow read: if true;
          allow create: if isSignedIn();
          allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
        }
      }
    }

    // --- User-Specific Data Rules ---
    match /users/{userId}/{document=**} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
  }
}